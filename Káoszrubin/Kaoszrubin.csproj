<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
    <Version>0.9.45</Version>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
		<PackageReference Include="NAudio" Version="3.0.1" />
		<None Update="Data\game-data.csv" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Sounds\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Pictures\**\*.png" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Music\**\*.mp3" CopyToOutputDirectory="PreserveNewest" />
		<Compile Remove="Tests\**\*.cs" />
		<Compile Remove="Tools\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="KaoszrubinTests" />
    <InternalsVisibleTo Include="PartyProgression.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="ForestLevelGraphs\*.json" />
		<None Remove="UI\Mainscreen.txt" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="ForestLevelGraphs\*.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="UI\Mainscreen.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
  
</Project>
