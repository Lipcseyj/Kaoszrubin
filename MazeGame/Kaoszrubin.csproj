<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
		<None Update="adatok.csv" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Sounds\**\*.wav" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Kepek\**\*.png" CopyToOutputDirectory="PreserveNewest" />
		<Compile Remove="Tests\**\*.cs" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="Start.bat" />
		<None Remove="UI\Mainscreen.txt" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Start.bat">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="UI\Mainscreen.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
</Project>
